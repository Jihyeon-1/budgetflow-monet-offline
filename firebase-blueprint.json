{
  "entities": {
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "categoryId": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "isFixed": { "type": "boolean" },
        "isOverspending": { "type": "boolean" },
        "incomeSource": { "type": "string", "maxLength": 100 },
        "memo": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "date", "type", "categoryId", "title", "amount", "accountId"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "User bank account with current balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bankName": { "type": "string", "maxLength": 50 },
        "accountName": { "type": "string", "maxLength": 50 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "balance": { "type": "number" },
        "color": { "type": "string", "maxLength": 20 },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "userId", "bankName", "accountName", "balance"]
    },
    "Category": {
      "title": "Category",
      "description": "Expense or income category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "label": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "color": { "type": "string", "maxLength": 20 },
        "isFixedDefault": { "type": "boolean" },
        "isCustom": { "type": "boolean" }
      },
      "required": ["id", "userId", "label", "type", "color"]
    },
    "InvestmentAsset": {
      "title": "InvestmentAsset",
      "description": "Stock, fund, deposit, or savings investment asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "symbol": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "enum": ["stock", "fund", "etf", "bond", "deposit", "savings"] },
        "investedAmount": { "type": "number" },
        "currentPrice": { "type": "number" },
        "currentValuation": { "type": "number" },
        "returnRate": { "type": "number" },
        "dailyChangeRate": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "memo": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "name", "type", "investedAmount", "currentPrice", "currentValuation"]
    },
    "BudgetSetting": {
      "title": "BudgetSetting",
      "description": "Monthly category budget map",
      "type": "object",
      "properties": {
        "userId": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User transaction records"
    },
    "/users/{userId}/bankAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "User bank account records"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User category settings"
    },
    "/users/{userId}/investments/{assetId}": {
      "schema": { "$ref": "#/entities/InvestmentAsset" },
      "description": "User investment assets"
    },
    "/users/{userId}/settings/budgets": {
      "schema": { "$ref": "#/entities/BudgetSetting" },
      "description": "User monthly category budgets"
    }
  }
}
